{
  "name": "babs-icons",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -pt run build",
    "icons:check": "yarn icons:flatten && yarn icons:sprites --check && yarn icons:gen-core --check && yarn icons:gen-react --check && yarn icons:verify",
    "icons:docs": "node packages/pipeline/src/gen-docs.ts",
    "icons:flatten": "node packages/pipeline/src/flatten.ts",
    "icons:gen-core": "node packages/pipeline/src/gen-core.ts",
    "icons:gen-react": "node packages/pipeline/src/gen-react.ts",
    "icons:ingest": "node packages/pipeline/src/normalize.ts --inplace && yarn icons:rebuild",
    "icons:rebuild": "yarn icons:flatten && yarn icons:sprites && yarn icons:gen-core && yarn icons:gen-react && yarn icons:verify && yarn icons:docs",
    "icons:source:copy-de": "node packages/pipeline/src/copy-de.ts",
    "icons:source:normalize": "node packages/pipeline/src/normalize.ts",
    "icons:source:trace": "node packages/pipeline/src/trace.ts",
    "icons:sprites": "node packages/pipeline/src/sprites.ts",
    "icons:verify": "node packages/pipeline/src/verify.ts",
    "typecheck": "yarn workspaces foreach -Apt exec tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
