{
  "name": "@f-eld-ch/babs-react",
  "version": "0.0.0",
  "description": "BABS icon library — React components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-eld-ch/babs-icons.git",
    "directory": "packages/react"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./named": {
      "types": "./dist/named.d.ts",
      "default": "./dist/named.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "devDependencies": {
    "@f-eld-ch/babs-core": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "@f-eld-ch/babs-core": "workspace:*",
    "react": ">=18"
  }
}
