{
  "name": "@f-eld-ch/babs-core",
  "version": "0.0.0",
  "description": "BABS icon library — core types, metadata, and language utilities",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-eld-ch/babs-icons.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ids": {
      "types": "./dist/generated/ids.d.ts",
      "default": "./dist/generated/ids.js"
    },
    "./tree": {
      "types": "./dist/generated/tree.d.ts",
      "default": "./dist/generated/tree.js"
    },
    "./labels/de": {
      "types": "./dist/generated/labels/de.d.ts",
      "default": "./dist/generated/labels/de.js"
    },
    "./labels/fr": {
      "types": "./dist/generated/labels/fr.d.ts",
      "default": "./dist/generated/labels/fr.js"
    },
    "./labels/it": {
      "types": "./dist/generated/labels/it.d.ts",
      "default": "./dist/generated/labels/it.js"
    },
    "./markers": {
      "types": "./dist/generated/markers.d.ts",
      "default": "./dist/generated/markers.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../pipeline/src/gen-core.ts && tsc --build"
  }
}
