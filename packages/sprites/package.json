{
  "name": "@f-eld-ch/babs-sprites",
  "version": "0.0.0",
  "type": "module",
  "description": "BABS icon library — per-language MapLibre sprite sheets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-eld-ch/babs-icons.git",
    "directory": "packages/sprites"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "layout.lock.json"
  ],
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
