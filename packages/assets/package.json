{
  "name": "@f-eld-ch/babs-assets",
  "version": "0.0.0",
  "type": "module",
  "description": "BABS icon library — optimized SVG files",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-eld-ch/babs-icons.git",
    "directory": "packages/assets"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && mkdir -p svg && cp -rL ../svg/de ../svg/fr ../svg/it svg/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "svg/"
  ]
}
